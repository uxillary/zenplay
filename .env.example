# Optional Supabase browser configuration (Vite build-time, included in the
# browser bundle). These values are public; never use a secret/service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Stripe values are server-only Supabase Edge Function secrets. Configure them
# with Supabase secrets after M17C-B; never prefix them with VITE_ or add values here.
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SIGNING_SECRET
# STRIPE_PRICE_SUPPORT_2_GBP
# STRIPE_PRICE_SUPPORT_5_GBP
# STRIPE_PRICE_SUPPORT_10_GBP
# STRIPE_CHECKOUT_SUCCESS_URL
# STRIPE_CHECKOUT_CANCEL_URL
